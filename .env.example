# ============================================================================
# FLIGHT HUNTER — environment variables
# Copy this file to .env.local (local dev) or configure the same keys as
# Environment Variables in your Vercel project. Never commit real secrets.
# ============================================================================

# --- Supabase --------------------------------------------------------------
# Leave all three empty/unset to run in DEMO MODE: the app uses an in-memory
# repository seeded with mock data automatically — no database required.
# Set these to switch to real persistence (see supabase/schema.sql).
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service role key — required for the scheduler/cron job to write across all
# users' searches while RLS is enabled. Server-side only, never expose to
# the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Flight data provider ----------------------------------------------------
# "mock" (default) | "amadeus" | "custom"
# See src/lib/providers/index.ts to register a new provider implementation.
FLIGHT_API_PROVIDER=mock

# Credentials for a real provider (e.g. Amadeus Self-Service API). Not read
# by MockFlightProvider; required once you implement AmadeusFlightProvider.
FLIGHT_API_KEY=
FLIGHT_API_SECRET=

# --- Alerts / notifications (integration seams — see README) ----------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=

# --- Cron protection ----------------------------------------------------------
# If set, /api/cron requires `Authorization: Bearer <CRON_SECRET>`.
# Vercel Cron sends this automatically when configured in vercel.json.
CRON_SECRET=
